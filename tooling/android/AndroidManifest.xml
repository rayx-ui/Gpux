<?xml version="1.0" encoding="utf-8"?>
<!--
  Lane E's conformance host: a NativeActivity that loads libandroid_host.so, the `android_host`
  example of gpux-conformance, with gpux's Java helper (`dev.gpux.mobile`, compiled into
  classes.dex). `gpux-testkit android build` links this manifest with aapt2, adds the dex and the
  native libraries uncompressed (so they load in place, 16 KB aligned), and signs the APK with a
  local debug key.

  The activity is debuggable so `run-as` can read the frames failing pixel probes save, and
  fullscreen so scene coordinates are screen coordinates for `adb shell input`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.gpux.conformance">

    <application
        android:label="gpux conformance"
        android:hasCode="true"
        android:debuggable="true"
        android:extractNativeLibs="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="android_host" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
